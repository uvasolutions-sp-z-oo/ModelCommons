# Dependencies and package-manager logs
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Expo / React Native generated state
.expo/
/android/
/ios/
dist/
web-build/
expo-env.d.ts

# Generated native-module build output (modules themselves remain tracked)
modules/*/android/build/
modules/*/android/.cxx/
modules/*/ios/build/
*.dex
*.apk
*.aab

# Test and publication output
coverage/
compliance/sbom/

# Local configuration and credentials
.env
.env.*
!.env.example
*.keystore
*.jks
*.p8
*.p12
*.mobileprovision

# Model artifacts are downloaded at runtime and never belong in source control
*.gguf
*.gguf.part

# Editors and operating systems
.DS_Store
Thumbs.db
.idea/
.vscode/
