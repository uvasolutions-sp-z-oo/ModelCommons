{
  "name": "@modelcommons/hub",
  "description": "An open protocol, model hub and runtime layer for sharing on-device AI models across applications.",
  "main": "expo-router/entry",
  "version": "0.1.0",
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0"
  },
  "workspaces": [
    "packages/*",
    "modules/*"
  ],
  "scripts": {
    "start": "expo start",
    "packages:pack-local": "node scripts/pack-local-packages.cjs",
    "eas-build-post-install": "node modules/model-commons-native/scripts/ensure-llama-payload.cjs",
    "android": "expo run:android",
    "preandroid": "node scripts/ensure-llama-rn-native.cjs",
    "android:prepare-native": "node scripts/ensure-llama-rn-native.cjs",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prebuild": "expo prebuild",
    "prebuild:clean": "expo prebuild --clean",
    "sbom": "node -e \"require('fs').mkdirSync('compliance/sbom',{recursive:true})\" && npx --yes @cyclonedx/cyclonedx-npm@5.0.0 --output-format JSON --output-file compliance/sbom/modelcommons.cdx.json"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@modelcommons/client": "0.1.0",
    "@modelcommons/model-store": "0.1.0",
    "@modelcommons/embedded": "0.1.0",
    "@modelcommons/device-profile": "0.1.0",
    "@modelcommons/native": "0.1.0",
    "@modelcommons/protocol": "0.1.0",
    "@modelcommons/provider-anthropic": "0.1.0",
    "@modelcommons/provider-openai": "0.1.0",
    "@modelcommons/runtime-llama-rn": "0.1.0",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "expo": "~54.0.33",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.21",
    "expo-file-system": "^19.0.21",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-linking": "~8.0.11",
    "expo-router": "~6.0.23",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "llama.rn": "0.12.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@types/react": "~19.1.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "typescript": "~5.9.2",
    "vitest": "^3.2.4"
  },
  "private": true
}
