# Optional, same-developer iOS storage sharing. Replace this with an App Group
# provisioned for every participating target; leave it unset otherwise.
MODELCOMMONS_APP_GROUP=group.com.example.modelcommons

# Voluntary output-report receiver. Production builds require an HTTPS URL.
# This value is public build configuration; do not put credentials or tokens in it.
MODELCOMMONS_REPORT_URL=https://uva.solutions/index.php?option=com_uvaleads&task=report.submit&format=json

# Local non-EAS release checks can set this to enforce the production URL gate.
MODELCOMMONS_PRODUCTION_BUILD=0
