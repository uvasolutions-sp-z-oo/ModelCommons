# Optional, same-developer iOS storage sharing. Replace this with an App Group
# provisioned for every participating target; leave it unset otherwise.
# MODELCOMMONS_APP_GROUP=group.com.example.modelcommons

# Existing installations keep Documents/ModelCommons by default. Optional owner
# selection: app-group downloads directly into the provisioned group. No migration.
# MODELCOMMONS_IOS_STORE=documents

# Optional operator-controlled output-report receiver. When omitted, reporting is
# unavailable and all other ModelCommons functionality continues normally. This
# is public build configuration; use HTTPS (or local loopback HTTP) and never put
# credentials or tokens in it.
# MODELCOMMONS_REPORT_URL=https://reports.example.org/modelcommons
